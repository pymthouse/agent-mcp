# Public origin of this MCP host (must match the emailed URL, no trailing slash).
MCP_PUBLIC_ORIGIN=https://agent.eliteencoder.net

# HMAC for DCR client_ids, PKCE cookies, and auth codes.
# May equal SSO_MINT_SECRET.
MCP_AS_SECRET=

# Console S2S mint / refresh / signer-session. Never M2M or Auth0 on this host.
CONSOLE_ORIGIN=https://livepeer-console.vercel.app
SSO_MINT_SECRET=
# Caller origin sent to Console allowlist. Defaults to MCP_PUBLIC_ORIGIN.
# SSO_MINT_CALLER_ORIGIN=https://agent.eliteencoder.net

# PymtHouse issuer — JWKS verify of user JWTs only. Not the authorization server.
PYMTHOUSE_ISSUER_URL=https://pymthouse.com/api/v1/oidc
# PYMTHOUSE_JWKS_URL=https://pymthouse.com/api/v1/oidc/jwks

# Signer DMZ fallback if Console exchange omits signer_url. Never signer.daydream.live
PYMTHOUSE_SIGNER_URL=https://signer.pymthouse.com

# Full raw discovery URL (origin is used for /v1/discovery/*).
DISCOVERY_SERVICE_URL=https://discovery-service-production-8955.up.railway.app/v1/discovery/raw

# Campaign MCP spend cap (USD). Agent may lower, not raise.
DEFAULT_SPEND_CAP_USD=25
